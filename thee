<style>
:root{--bg:#14110f;--bg2:#1d1916;--ink:#f6efe3;--mute:#b5a998;--red:#e8422b;--gold:#f4b73a;--line:#ffffff1f;--btn-ink:#14110f;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#fbf4e6;--bg2:#f2e7d0;--ink:#1d1916;--mute:#6d6152;--red:#c9301a;--gold:#b97d00;--line:#1d19161f;--btn-ink:#fbf4e6}}
:root[data-theme="light"]{--bg:#fbf4e6;--bg2:#f2e7d0;--ink:#1d1916;--mute:#6d6152;--red:#c9301a;--gold:#b97d00;--line:#1d19161f;--btn-ink:#fbf4e6}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:70px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.55 "DM Sans",system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3{font-family:Anton,Impact,sans-serif;font-weight:400;text-transform:uppercase;letter-spacing:.01em;margin:0;line-height:.95}
a{color:inherit}:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding:0 22px}
header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:62px}
.logo{font-family:Anton;font-size:24px;text-decoration:none;letter-spacing:.04em}.logo b{color:var(--red);font-weight:400}
nav a{margin-left:20px;text-decoration:none;font-weight:500;font-size:15px;color:var(--mute)}nav a:hover{color:var(--ink)}
.btn{display:inline-flex;align-items:center;gap:8px;padding:14px 24px;border-radius:999px;background:var(--red);color:#fff;font-weight:700;text-decoration:none;border:2px solid var(--red);cursor:pointer;font:700 16px "DM Sans",sans-serif;transition:transform .2s}
.btn:hover{transform:translateY(-3px)}.btn.ghost{background:none;color:var(--ink);border-color:var(--line)}
.hero{position:relative;padding:60px 0 90px;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:30px;align-items:center}
.badge{display:inline-flex;gap:8px;align-items:center;padding:6px 14px;border:1px solid var(--line);border-radius:999px;font-size:14px;color:var(--mute)}
.dot{width:9px;height:9px;border-radius:50%;background:#888}.dot.on{background:#3ecf6e;box-shadow:0 0 0 4px #3ecf6e33}
h1{font-size:clamp(64px,13vw,168px);margin:20px 0 14px}h1 span{color:var(--red);display:block}
.lead{max-width:460px;color:var(--mute);font-size:19px}.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
.shot{position:relative;width:min(400px,84vw);margin:0 auto;transform:rotate(2.5deg)}
.shot img.ph{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:22px;border:6px solid var(--ink);box-shadow:0 24px 50px #0007}
.shot .hunter{position:absolute;width:64%;left:-30%;bottom:-12%;transform:rotate(-6deg);background:#f6efe3;border:4px solid #14110f;border-radius:30%;padding:7%;box-shadow:6px 8px 0 #14110f;animation:bob 3.2s ease-in-out infinite}
@keyframes bob{50%{transform:rotate(-3deg) translateY(-8px)}}
.slogan{margin-top:22px;font:400 20px Anton;text-transform:uppercase;letter-spacing:.06em;color:var(--gold)}
.gal{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:34px}
.gal figure{margin:0;position:relative;border-radius:20px;overflow:hidden;border:1px solid var(--line)}
.gal img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s}.gal figure:hover img{transform:scale(1.04)}
.gal figcaption{position:absolute;left:14px;bottom:12px;background:var(--bg);color:var(--ink);padding:6px 14px;border-radius:999px;font:700 14px "DM Sans"}
.visit-h{width:150px;margin:26px 0 0;display:block}
@media(max-width:820px){.gal{grid-template-columns:1fr}.shot .hunter{left:-4%;width:52%;bottom:-16%}.shot{margin-bottom:50px}}
.seal{position:relative;width:min(340px,78vw);aspect-ratio:1;margin:0 auto;display:grid;place-items:center;text-align:center;font-family:Anton;text-transform:uppercase;line-height:.95;transform:rotate(-8deg)}
.seal::before{content:"";position:absolute;inset:0;border-radius:50%;border:3px dashed var(--gold);animation:spin 40s linear infinite}
.seal::after{content:"";position:absolute;inset:10%;border-radius:50%;background:var(--red)}
.seal span{position:relative;z-index:1;color:#fff;font-size:clamp(40px,9vw,64px)}.seal small{display:block;font:500 14px "DM Sans";letter-spacing:.14em;margin-top:10px}
@keyframes spin{to{transform:rotate(360deg)}}
.marq{background:var(--red);color:#fff;overflow:hidden;white-space:nowrap;padding:12px 0;font-family:Anton;font-size:26px;text-transform:uppercase}
.marq div{display:inline-block;animation:mq 28s linear infinite}@keyframes mq{to{transform:translateX(-50%)}}
section{padding:90px 0}h2{font-size:clamp(46px,8vw,92px)}.sub{color:var(--mute);max-width:560px;margin:14px 0 0}
.tabs{display:flex;flex-wrap:wrap;gap:10px;margin:34px 0 26px}
.tab{padding:10px 20px;border-radius:999px;border:1px solid var(--line);background:none;color:var(--ink);font:500 15px "DM Sans";cursor:pointer}
.tab[aria-selected="true"]{background:var(--gold);color:#14110f;border-color:var(--gold);font-weight:700}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.card{background:var(--bg2);border:1px solid var(--line);border-radius:18px;padding:22px;display:flex;flex-direction:column;gap:10px;transform-style:preserve-3d;transition:transform .15s,border-color .2s}
.card:hover{border-color:var(--gold)}.card .top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.card h3{font-size:30px}.price{font-family:Anton;font-size:28px;color:var(--gold)}.card p{margin:0;color:var(--mute);font-size:15px}
.tag{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--red);font-weight:700}
.note{margin-top:22px;font-size:14px;color:var(--mute)}
.alt{background:var(--bg2);border-block:1px solid var(--line)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:start}
.stats{display:flex;gap:34px;margin-top:26px;flex-wrap:wrap}.stats b{font:400 56px Anton;color:var(--gold);display:block;line-height:1}.stats span{color:var(--mute);font-size:14px}
blockquote{margin:0;padding:26px;border-left:4px solid var(--red);background:var(--bg);border-radius:0 16px 16px 0;font-size:21px}
blockquote cite{display:block;margin-top:12px;font-size:14px;color:var(--mute);font-style:normal}
table{width:100%;border-collapse:collapse;margin-top:18px}td{padding:11px 0;border-bottom:1px solid var(--line)}td:last-child{text-align:right;font-weight:700}
.today td{color:var(--gold)}
.info p{margin:8px 0}.info .row{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
footer{padding:34px 0;border-top:1px solid var(--line);color:var(--mute);font-size:14px}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
.rv{opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s}.rv.in{opacity:1;transform:none}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,30px);background:var(--ink);color:var(--bg);padding:12px 20px;border-radius:999px;opacity:0;pointer-events:none;transition:.3s;z-index:30;font-weight:700}
.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:820px){.hero .wrap,.two{grid-template-columns:1fr}nav a:not(.keep){display:none}section{padding:64px 0}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}html{scroll-behavior:auto}}
</style>
</head>
