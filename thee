<script>
const MENU={
"Hamburguesas":[
["California Cheese",230,"Carne de res, cheddar, lechuga, tomate, cebolla, pepinillos y aderezo de la casa.","Clásica"],
["Guacamole N Bacon",255,"Carne de res, queso Monterrey Jack, guacamole, tiras de tocino, lechuga, tomate, cebolla, pepinillos y aderezo de la casa.","Favorita"],
["Smash And Cheese",205,"Carne estilo smash, cheddar, cebolla caramelizada y aderezo de la casa.","Smash"],
["Sunset",215,"Carne de res, cheddar, lechuga, piña, tomate, cebolla, pepinillos y aderezo de la casa.","Popular"],
["Westie",245,"Carne de res, cheddar, tocino, aros de cebolla y aderezo BBQ.","Crujiente"],
["Baconator",245,"Carne de res, cheddar, triple porción de tocino y aderezo chipotle.","Tocino x3"],
["Green Belly",239,"150 g de sirloin 100%, panceta de cerdo en trozos, Monterrey Jack, guacamole y aderezo de la casa.","Sirloin"],
["Crispy Chicken",205,"Pollo frito con receta de la casa, cheddar, lechuga, tomate, cebolla y aderezo de la casa.","Pollo"],
["Buffalo Crispy",199,"Pollo crujiente bañado en BBQ o búfalo, cheddar, lechuga, tomate, cebolla, pepinillos y ranch.","Pollo"]],
"Fries":[
["Chick N Fries",230,"Papas a la francesa con palomitas de pollo frito, jalapeños y aderezo de la casa.","Para compartir"],
["Bacon Cheese N Fries",199,"Papas a la francesa con tocino troceado y dip de queso tipo cheddar.","Para compartir"],
["Boneless N Fries",240,"300 g de pechuga de pollo crujiente con tu salsa favorita, papas a la francesa y ranch.","Para compartir"],
["Cheddar N Wedge",165,"Papas gajo cubiertas con queso tipo cheddar.","Para compartir"]],
"Extras y bebidas":[
["Papas a la francesa",95,"Sazonadas con sal, se sirven con aderezo.","Extra"],
["Papas gajo",109,"Crujientes, perfectas como acompañamiento.","Extra"],
["Aros de cebolla",129,"Empanizados, crujientes y dorados.","Extra"],
["Refresco en lata",45,"Línea Coca-Cola, lata de 355 ml.","Bebida"]]};
const tabs=document.querySelector(".tabs"),grid=document.getElementById("grid");
const mx=n=>"$"+n.toLocaleString("es-MX");
function show(k){
 tabs.querySelectorAll(".tab").forEach(t=>t.setAttribute("aria-selected",t.dataset.k===k));
 grid.replaceChildren(...MENU[k].map(([n,p,d,t])=>{
  const c=document.createElement("article");c.className="card";
  const top=document.createElement("div");top.className="top";
  const h=document.createElement("h3");h.textContent=n;
  const pr=document.createElement("span");pr.className="price";pr.textContent=mx(p);
  top.append(h,pr);
  const tg=document.createElement("span");tg.className="tag";tg.textContent=t;
  const pd=document.createElement("p");pd.textContent=d;
  c.append(tg,top,pd);return c;}));
 tiltInit();
}
Object.keys(MENU).forEach((k,i)=>{const b=document.createElement("button");b.className="tab";b.role="tab";b.type="button";b.dataset.k=k;b.textContent=k;b.onclick=()=>show(k);tabs.append(b)});
function tiltInit(){
 if(matchMedia("(hover:none),(prefers-reduced-motion:reduce)").matches)return;
 grid.querySelectorAll(".card").forEach(c=>{
  c.onmousemove=e=>{const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;c.style.transform=`perspective(700px) rotateY(${x*6}deg) rotateX(${-y*6}deg)`};
  c.onmouseleave=()=>c.style.transform="";});
}
show("Hamburguesas");
// Horario
const DAYS=["Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado"],OPEN=14.5,CLOSE=21.5;
const now=new Date(new Date().toLocaleString("en-US",{timeZone:"America/Mazatlan"}));
const h=now.getHours()+now.getMinutes()/60,isOpen=h>=OPEN&&h<CLOSE;
document.getElementById("dot").classList.toggle("on",isOpen);
document.getElementById("status").textContent=isOpen?"Abierto ahora · hasta las 9:30 p. m.":"Cerrado ahora · abrimos a las 2:30 p. m.";
document.getElementById("hours").replaceChildren(...DAYS.slice(1).concat(DAYS[0]).map(d=>{
 const tr=document.createElement("tr");if(d===DAYS[now.getDay()])tr.className="today";
 const a=document.createElement("td"),b=document.createElement("td");a.textContent=d;b.textContent="2:30 p. m. – 9:30 p. m.";tr.append(a,b);return tr;}));
// Copiar
const toast=document.getElementById("toast");
function say(m){toast.textContent=m;toast.classList.add("show");setTimeout(()=>toast.classList.remove("show"),2600)}
document.getElementById("call").addEventListener("click",async e=>{
 if(matchMedia("(hover:none)").matches)return;
 e.preventDefault();
 try{await navigator.clipboard.writeText("612 131 8021");say("Número copiado: 612 131 8021")}catch(x){say("Llama al 612 131 8021")}
});
// Reveal
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}}),{threshold:.15});
document.querySelectorAll(".rv").forEach(el=>io.observe(el));
</script>
